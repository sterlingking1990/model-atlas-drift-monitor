# All optional. Copy to .env.local and fill in what you need.

# Populates real per-provider voice ids for the Retell catalog adapter.
# Without it, Retell voice providers are still listed, just with empty
# model lists (see model-atlas's retell adapter docs).
RETELL_API_KEY=

# If set, a Slack incoming-webhook URL that gets a message whenever a
# /api/check run detects any drift.
SLACK_WEBHOOK_URL=

# Only relevant once deployed to Vercel with the vercel.json cron config
# active: verifies a /api/check request actually came from Vercel's
# scheduler (Vercel sets this automatically). Unused for local dev.
CRON_SECRET=
